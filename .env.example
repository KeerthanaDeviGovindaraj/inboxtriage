# ──────────────────────────────────────────────────────────────────────────────
# InboxTriage — environment variables
#
# Copy this file to .env.local and fill in your key:
#   cp .env.example .env.local
#
# .env.local is gitignored and never committed.
# ──────────────────────────────────────────────────────────────────────────────

# Optional. Your OpenAI API key.
# Without it, the app runs in demo mode (canned sample results, no API calls).
# With it, the triage endpoint makes live model calls.
# Read server-side only (in app/api/triage/route.ts and lib/openai.ts) —
# it is never exposed to the browser.
# Get one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Optional. Default model shown in the UI selector.
# One of: gpt-4o-mini | gpt-4o
# NEXT_PUBLIC_DEFAULT_MODEL=gpt-4o-mini
